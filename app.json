{
  "expo": {
    "name": "Lote",
    "slug": "lote",
    "scheme": "lote",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Renomeador de arquivos em lote para celulares e tablets.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fabiosantos.lote",
      "appleTeamId": "77MXYLFJ7J",
      "icon": "./assets/lote.icon",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDisplayName": "Lote",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.fabiosantos.lote"
        ]
      }
    },
    "android": {
      "package": "com.gwin14.lote",
      "adaptiveIcon": {
        "backgroundColor": "#D9480F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "locales": {
      "en": "./locales/en.json",
      "pt": "./locales/pt.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    },
    "plugins": [
      "expo-router",
      "./plugins/withReleaseScheme",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.fabiosantos.lote",
            "activationRule": {
              "supportsImageWithMaxCount": 500,
              "supportsMovieWithMaxCount": 100,
              "supportsFileWithMaxCount": 500
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "video/*",
              "audio/*",
              "application/*",
              "text/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "audio/*",
              "application/*",
              "text/*",
              "*/*"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Lote acessa as fotos que você escolher para renomeá-las.",
          "cameraPermission": "O Lote usa a câmera para tirar fotos já com o nome certo."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Lote acessa suas fotos para renomeá-las.",
          "savePhotosPermission": "O Lote salva nas Fotos as cópias renomeadas que você escolher.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-quick-actions",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Lote",
              "label": "Lote",
              "description": "Renomeie fotos e arquivos com um toque",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "pt", "es", "fr", "de"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
